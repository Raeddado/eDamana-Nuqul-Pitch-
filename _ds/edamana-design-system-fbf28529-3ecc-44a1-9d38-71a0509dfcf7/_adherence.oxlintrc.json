        "message": "<Dialog> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EcosystemNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|kind|kindLabel|flow|state|icon|x|y|key|ref|className|style|children)$/]",
